{
  "id": "grammar_a2",
  "version": 1,
  "cefr": "A2",
  "questions": [
    {"id":"gr_a2_001","skill":"grammar","topic":"tenses.present_simple","cefr":"A2","difficulty":0.2,"exams":["general","konkur"],"passage_id":null,"stem":"She ____ to school every day.","options":["go","goes","going","is go"],"answer":1,"explanation_fa":"در حال ساده، وقتی فاعل سوم‌شخص مفرد است (she) فعل s می‌گیرد: goes.","status":"draft","version":1},
    {"id":"gr_a2_002","skill":"grammar","topic":"tenses.present_simple","cefr":"A2","difficulty":0.2,"exams":["general"],"passage_id":null,"stem":"____ you like coffee?","options":["Does","Are","Do","Is"],"answer":2,"explanation_fa":"سؤال حال ساده با فاعل you با Do ساخته می‌شود. Does فقط برای he/she/it است.","status":"draft","version":1},
    {"id":"gr_a2_003","skill":"grammar","topic":"tenses.present_continuous","cefr":"A2","difficulty":0.25,"exams":["general"],"passage_id":null,"stem":"My brother ____ TV right now.","options":["watches","watched","is watching","watch"],"answer":2,"explanation_fa":"right now نشانهٔ حال استمراری است: am/is/are + فعل ing‌دار.","status":"draft","version":1},
    {"id":"gr_a2_004","skill":"grammar","topic":"tenses.present_continuous","cefr":"A2","difficulty":0.3,"exams":["general"],"passage_id":null,"stem":"Listen! The baby ____.","options":["is crying","cries","cried","cry"],"answer":0,"explanation_fa":"Listen! یعنی کار همین حالا در جریان است، پس حال استمراری لازم است.","status":"draft","version":1},
    {"id":"gr_a2_005","skill":"grammar","topic":"tenses.past_simple","cefr":"A2","difficulty":0.25,"exams":["general","konkur"],"passage_id":null,"stem":"We ____ in Shiraz last summer.","options":["are","was","be","were"],"answer":3,"explanation_fa":"last summer زمان گذشته است. گذشتهٔ be برای we می‌شود were.","status":"draft","version":1},
    {"id":"gr_a2_006","skill":"grammar","topic":"tenses.past_simple","cefr":"A2","difficulty":0.2,"exams":["general"],"passage_id":null,"stem":"I ____ my homework yesterday.","options":["finish","finishing","finished","have finish"],"answer":2,"explanation_fa":"yesterday نشانهٔ گذشتهٔ ساده است: فعل + ed.","status":"draft","version":1},
    {"id":"gr_a2_007","skill":"grammar","topic":"tenses.past_simple","cefr":"A2","difficulty":0.35,"exams":["general","konkur"],"passage_id":null,"stem":"Did you ____ the film last night?","options":["saw","see","seen","seeing"],"answer":1,"explanation_fa":"بعد از did فعل همیشه به شکل ساده (مصدر بدون to) می‌آید، چون did خودش زمان گذشته را نشان می‌دهد.","status":"draft","version":1},
    {"id":"gr_a2_008","skill":"grammar","topic":"tenses.past_simple","cefr":"A2","difficulty":0.35,"exams":["general"],"passage_id":null,"stem":"They didn't ____ to the party.","options":["came","comes","come","coming"],"answer":2,"explanation_fa":"در منفی گذشتهٔ ساده (didn't) فعل اصلی ساده می‌آید: didn't come.","status":"draft","version":1},
    {"id":"gr_a2_009","skill":"grammar","topic":"tenses.future_going_to","cefr":"A2","difficulty":0.35,"exams":["general"],"passage_id":null,"stem":"Look at those dark clouds! It ____ rain.","options":["goes to","is going to","will to","going"],"answer":1,"explanation_fa":"وقتی از روی نشانه‌های فعلی (ابرهای تیره) پیش‌بینی می‌کنیم، be going to به کار می‌رود.","status":"draft","version":1},
    {"id":"gr_a2_010","skill":"grammar","topic":"tenses.future_going_to","cefr":"A2","difficulty":0.3,"exams":["general"],"passage_id":null,"stem":"I ____ visit my grandmother tomorrow. I bought her a present.","options":["going to","go to","am going to","am go"],"answer":2,"explanation_fa":"برای برنامهٔ ازپیش‌تصمیم‌گرفته‌شده از am/is/are going to + فعل ساده استفاده می‌کنیم.","status":"draft","version":1},
    {"id":"gr_a2_011","skill":"grammar","topic":"comparatives","cefr":"A2","difficulty":0.25,"exams":["general","konkur"],"passage_id":null,"stem":"Tehran is ____ than Isfahan.","options":["big","biggest","more big","bigger"],"answer":3,"explanation_fa":"صفت تک‌هجایی در مقایسه er می‌گیرد. چون big به یک صامت ختم می‌شود، g دوبار نوشته می‌شود: bigger than.","status":"draft","version":1},
    {"id":"gr_a2_012","skill":"grammar","topic":"comparatives","cefr":"A2","difficulty":0.3,"exams":["general"],"passage_id":null,"stem":"This book is ____ than that one.","options":["more interesting","interesting","most interesting","interestinger"],"answer":0,"explanation_fa":"صفت‌های بلند (چندهجایی) در مقایسه با more ... than می‌آیند.","status":"draft","version":1},
    {"id":"gr_a2_013","skill":"grammar","topic":"comparatives.superlative","cefr":"A2","difficulty":0.3,"exams":["general","konkur"],"passage_id":null,"stem":"Damavand is the ____ mountain in Iran.","options":["higher","high","highest","most high"],"answer":2,"explanation_fa":"the + صفت عالی برای برترین در یک گروه است. صفت کوتاه est می‌گیرد: the highest.","status":"draft","version":1},
    {"id":"gr_a2_014","skill":"grammar","topic":"comparatives","cefr":"A2","difficulty":0.45,"exams":["general"],"passage_id":null,"stem":"My test result was ____ than yours.","options":["badder","worse","worst","more bad"],"answer":1,"explanation_fa":"bad بی‌قاعده است: bad / worse / the worst. چون than آمده، شکل مقایسه‌ای (worse) لازم است.","status":"draft","version":1},
    {"id":"gr_a2_015","skill":"grammar","topic":"articles","cefr":"A2","difficulty":0.25,"exams":["general"],"passage_id":null,"stem":"She is ____ engineer.","options":["a","an","the","some"],"answer":1,"explanation_fa":"engineer با صدای مصوت شروع می‌شود، پس an می‌گیرد.","status":"draft","version":1},
    {"id":"gr_a2_016","skill":"grammar","topic":"articles","cefr":"A2","difficulty":0.35,"exams":["general"],"passage_id":null,"stem":"Can you close ____ door, please? It's cold in here.","options":["a","an","some","the"],"answer":3,"explanation_fa":"منظور در مشخصی است که هر دو نفر می‌دانند کدام است، پس the.","status":"draft","version":1},
    {"id":"gr_a2_017","skill":"grammar","topic":"articles","cefr":"A2","difficulty":0.45,"exams":["general"],"passage_id":null,"stem":"He plays ____ guitar very well.","options":["the","a","an","some"],"answer":0,"explanation_fa":"وقتی دربارهٔ نواختن ساز حرف می‌زنیم، قبل از نام ساز the می‌آید: play the guitar.","status":"draft","version":1},
    {"id":"gr_a2_018","skill":"grammar","topic":"prepositions.time","cefr":"A2","difficulty":0.2,"exams":["general","konkur"],"passage_id":null,"stem":"The meeting is ____ Monday.","options":["in","at","on","by"],"answer":2,"explanation_fa":"قبل از روزهای هفته و تاریخ‌ها on می‌آید.","status":"draft","version":1},
    {"id":"gr_a2_019","skill":"grammar","topic":"prepositions.time","cefr":"A2","difficulty":0.25,"exams":["general"],"passage_id":null,"stem":"I was born ____ 2008.","options":["in","on","at","by"],"answer":0,"explanation_fa":"قبل از سال، ماه و فصل in می‌آید.","status":"draft","version":1},
    {"id":"gr_a2_020","skill":"grammar","topic":"prepositions.time","cefr":"A2","difficulty":0.25,"exams":["general"],"passage_id":null,"stem":"The class starts ____ 8 o'clock.","options":["in","on","for","at"],"answer":3,"explanation_fa":"قبل از ساعت دقیق at می‌آید.","status":"draft","version":1},
    {"id":"gr_a2_021","skill":"grammar","topic":"prepositions.place","cefr":"A2","difficulty":0.2,"exams":["general"],"passage_id":null,"stem":"The keys are ____ the table.","options":["at","on","in","to"],"answer":1,"explanation_fa":"روی سطح چیزی: on.","status":"draft","version":1},
    {"id":"gr_a2_022","skill":"grammar","topic":"prepositions.place","cefr":"A2","difficulty":0.25,"exams":["general"],"passage_id":null,"stem":"She lives ____ Mashhad.","options":["at","on","to","in"],"answer":3,"explanation_fa":"قبل از نام شهر و کشور in می‌آید.","status":"draft","version":1},
    {"id":"gr_a2_023","skill":"grammar","topic":"prepositions.place","cefr":"A2","difficulty":0.3,"exams":["general"],"passage_id":null,"stem":"The cat is hiding ____ the bed.","options":["between","under","among","through"],"answer":1,"explanation_fa":"under یعنی زیر. between برای میان دو چیز و among برای میان چند چیز است.","status":"draft","version":1},
    {"id":"gr_a2_024","skill":"grammar","topic":"modals.obligation","cefr":"A2","difficulty":0.4,"exams":["general","konkur"],"passage_id":null,"stem":"You ____ smoke in the hospital. It's against the rules.","options":["mustn't","don't have to","can","should"],"answer":0,"explanation_fa":"mustn't یعنی ممنوع است. don't have to یعنی لازم نیست، که با «خلاف قانون است» جور درنمی‌آید.","status":"draft","version":1},
    {"id":"gr_a2_025","skill":"grammar","topic":"modals.ability","cefr":"A2","difficulty":0.2,"exams":["general"],"passage_id":null,"stem":"\"____ you swim?\" \"Yes, I can.\"","options":["Do","Are","Can","Must"],"answer":2,"explanation_fa":"جواب با can آمده (Yes, I can)، پس سؤال هم باید با Can پرسیده شود.","status":"draft","version":1},
    {"id":"gr_a2_026","skill":"grammar","topic":"modals.advice","cefr":"A2","difficulty":0.3,"exams":["general"],"passage_id":null,"stem":"It's very cold. You ____ wear a coat.","options":["mustn't","should","can't","shouldn't"],"answer":1,"explanation_fa":"برای توصیه should به کار می‌رود: بهتر است کت بپوشی.","status":"draft","version":1},
    {"id":"gr_a2_027","skill":"grammar","topic":"modals.obligation","cefr":"A2","difficulty":0.5,"exams":["general","konkur"],"passage_id":null,"stem":"Tomorrow is a holiday, so I ____ get up early.","options":["mustn't","can't","don't have to","shouldn't"],"answer":2,"explanation_fa":"don't have to یعنی لازم نیست. فردا تعطیل است و زود بیدار شدن اجباری نیست، ولی ممنوع هم نیست (mustn't).","status":"draft","version":1},
    {"id":"gr_a2_028","skill":"grammar","topic":"quantifiers","cefr":"A2","difficulty":0.3,"exams":["general","konkur"],"passage_id":null,"stem":"How ____ sugar do you want in your tea?","options":["many","much","a lot","few"],"answer":1,"explanation_fa":"sugar غیرقابل‌شمارش است. برای پرسیدن مقدار آن How much می‌آید.","status":"draft","version":1},
    {"id":"gr_a2_029","skill":"grammar","topic":"quantifiers","cefr":"A2","difficulty":0.3,"exams":["general"],"passage_id":null,"stem":"There aren't ____ apples in the fridge.","options":["some","much","any","a"],"answer":2,"explanation_fa":"در جملهٔ منفی و سؤالی معمولاً any به کار می‌رود.","status":"draft","version":1},
    {"id":"gr_a2_030","skill":"grammar","topic":"quantifiers","cefr":"A2","difficulty":0.25,"exams":["general"],"passage_id":null,"stem":"How ____ brothers do you have?","options":["many","much","any","lot"],"answer":0,"explanation_fa":"brothers قابل‌شمارش و جمع است، پس How many.","status":"draft","version":1},
    {"id":"gr_a2_031","skill":"grammar","topic":"quantifiers","cefr":"A2","difficulty":0.45,"exams":["general"],"passage_id":null,"stem":"Would you like ____ tea?","options":["any","many","a","some"],"answer":3,"explanation_fa":"در پیشنهاد و تعارف مؤدبانه، حتی در جملهٔ سؤالی، some به کار می‌رود.","status":"draft","version":1},
    {"id":"gr_a2_032","skill":"grammar","topic":"pronouns.possessive","cefr":"A2","difficulty":0.35,"exams":["general"],"passage_id":null,"stem":"This isn't my bag. It's ____.","options":["her","hers","she","herself"],"answer":1,"explanation_fa":"بعد از It's و بدون اسم، ضمیر ملکی مستقل لازم است: hers (مال او).","status":"draft","version":1},
    {"id":"gr_a2_033","skill":"grammar","topic":"pronouns.subject_object","cefr":"A2","difficulty":0.4,"exams":["general"],"passage_id":null,"stem":"Ali and ____ went to the cinema.","options":["me","my","I","mine"],"answer":2,"explanation_fa":"این بخش فاعل جمله است (Ali and I went)، پس ضمیر فاعلی I لازم است.","status":"draft","version":1},
    {"id":"gr_a2_034","skill":"grammar","topic":"pronouns.subject_object","cefr":"A2","difficulty":0.25,"exams":["general"],"passage_id":null,"stem":"Can you help ____ with this box?","options":["I","my","mine","me"],"answer":3,"explanation_fa":"بعد از فعل (help) ضمیر مفعولی می‌آید: me.","status":"draft","version":1},
    {"id":"gr_a2_035","skill":"grammar","topic":"questions.wh","cefr":"A2","difficulty":0.15,"exams":["general"],"passage_id":null,"stem":"\"____ do you live?\" \"In Tabriz.\"","options":["What","Where","When","Who"],"answer":1,"explanation_fa":"جواب یک مکان است، پس Where.","status":"draft","version":1},
    {"id":"gr_a2_036","skill":"grammar","topic":"questions.wh","cefr":"A2","difficulty":0.15,"exams":["general"],"passage_id":null,"stem":"\"____ is your birthday?\" \"In May.\"","options":["Where","Who","When","Which"],"answer":2,"explanation_fa":"جواب یک زمان است، پس When.","status":"draft","version":1},
    {"id":"gr_a2_037","skill":"grammar","topic":"questions.wh","cefr":"A2","difficulty":0.45,"exams":["general"],"passage_id":null,"stem":"\"____ car is this?\" \"It's my father's.\"","options":["Who","Whose","Which","Who's"],"answer":1,"explanation_fa":"برای پرسیدن مالکیت Whose به کار می‌رود. Who's مخفف Who is است.","status":"draft","version":1},
    {"id":"gr_a2_038","skill":"grammar","topic":"there_is_are","cefr":"A2","difficulty":0.25,"exams":["general"],"passage_id":null,"stem":"There ____ a lot of people at the station.","options":["is","be","are","was being"],"answer":2,"explanation_fa":"people جمع است، پس There are.","status":"draft","version":1},
    {"id":"gr_a2_039","skill":"grammar","topic":"there_is_are","cefr":"A2","difficulty":0.35,"exams":["general"],"passage_id":null,"stem":"There ____ any milk left.","options":["aren't","isn't","not","doesn't"],"answer":1,"explanation_fa":"milk غیرقابل‌شمارش است و فعل مفرد می‌گیرد: There isn't.","status":"draft","version":1},
    {"id":"gr_a2_040","skill":"grammar","topic":"tenses.present_simple","cefr":"A2","difficulty":0.15,"exams":["general"],"passage_id":null,"stem":"I ____ breakfast at 7 every morning.","options":["having","has","am have","have"],"answer":3,"explanation_fa":"every morning عادت را نشان می‌دهد و حال ساده لازم است. با فاعل I فعل s نمی‌گیرد.","status":"draft","version":1},
    {"id":"gr_a2_041","skill":"grammar","topic":"tenses.present_simple","cefr":"A2","difficulty":0.3,"exams":["general"],"passage_id":null,"stem":"He ____ never late for class.","options":["does","is","has","do"],"answer":1,"explanation_fa":"late صفت است و قبل از صفت فعل be لازم است: He is never late.","status":"draft","version":1},
    {"id":"gr_a2_042","skill":"grammar","topic":"tenses.past_continuous","cefr":"A2","difficulty":0.4,"exams":["general"],"passage_id":null,"stem":"What ____ you doing at 8 o'clock last night?","options":["was","did","were","are"],"answer":2,"explanation_fa":"گذشتهٔ استمراری با was/were + ing ساخته می‌شود و با you از were استفاده می‌کنیم.","status":"draft","version":1},
    {"id":"gr_a2_043","skill":"grammar","topic":"gerund_infinitive","cefr":"A2","difficulty":0.35,"exams":["general"],"passage_id":null,"stem":"I like ____ books in my free time.","options":["read","reading","to reading","reads"],"answer":1,"explanation_fa":"بعد از like فعل ing‌دار (یا to + مصدر) می‌آید. از بین گزینه‌ها reading درست است.","status":"draft","version":1},
    {"id":"gr_a2_044","skill":"grammar","topic":"gerund_infinitive","cefr":"A2","difficulty":0.35,"exams":["general","konkur"],"passage_id":null,"stem":"She wants ____ a doctor.","options":["become","becoming","became","to become"],"answer":3,"explanation_fa":"بعد از want همیشه to + مصدر می‌آید.","status":"draft","version":1},
    {"id":"gr_a2_045","skill":"grammar","topic":"adverbs","cefr":"A2","difficulty":0.4,"exams":["general"],"passage_id":null,"stem":"She speaks English very ____.","options":["good","well","best","better"],"answer":1,"explanation_fa":"برای توصیف فعل (speaks) قید لازم است. قید good می‌شود well.","status":"draft","version":1}
  ]
}
